{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": ["./tsconfig.json"]
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".vscode/",
    "coverage/",
    "**/dist/**",
    "**/node_modules/**",
    "opencode-orchestration/mcp-server/**",
    "opencode-orchestration/scripts/**",
    "opencode-orchestration/packs/**",
    "xx-stack/packs/**"
  ],
  "rules": {
    "@typescript-eslint/explicit-function-return-type": "warn",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-namespace": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["xx-stack/scripts/**/*.mjs", "xx-stack/scripts/**/*.js"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": 2023,
        "project": null
      },
      "env": {
        "node": true,
        "es2023": true
      },
      "extends": ["eslint:recommended"],
      "rules": {
        "@typescript-eslint/explicit-function-return-type": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "no-console": "off",
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "no-shadow": "error",
        "no-undef": "error"
      }
    },
    {
      "files": ["xx-stack/scripts/**/*.mjs"],
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["xx-stack/scripts/**/*.js"],
      "parserOptions": {
        "sourceType": "script"
      },
      "rules": {
        "@typescript-eslint/no-require-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/explicit-function-return-type": "off"
      }
    },
    {
      "files": [
        "xx-stack/mcp-server/src/monitor-memory.ts",
        "xx-stack/mcp-server/src/parallel-preflight.ts",
        "xx-stack/mcp-server/src/parallel-smoke.ts",
        "xx-stack/mcp-server/src/trace-provider-proxy.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}

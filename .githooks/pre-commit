#!/bin/bash
# Pre-commit hook: keep the VS Code agent mirrors in sync with canonical agents.
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SYNC_SCRIPT="$REPO_ROOT/xx-stack/scripts/sync-vscode-agents.mjs"

if [ ! -f "$SYNC_SCRIPT" ]; then
    echo "[xx-stack] pre-commit: sync script not found at $SYNC_SCRIPT — skipping." >&2
    exit 0
fi

echo "[xx-stack] Checking VS Code agent mirror sync..."

if ! node "$SYNC_SCRIPT" --check; then
    echo ""
    echo "ERROR: VS Code agent mirrors are out of sync with canonical agents."
    echo "Run:  npm run agents:sync"
    echo "Then stage the updated files and commit again."
    exit 1
fi

echo "[xx-stack] Agent mirrors are in sync."

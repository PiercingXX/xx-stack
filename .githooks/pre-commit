#!/bin/bash
# Pre-commit hook: keep the OpenCode skill/agent copies aligned with runtime/.
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
DRIFT_SCRIPT="$REPO_ROOT/scripts/check-stack-source-drift.mjs"

if [ ! -f "$DRIFT_SCRIPT" ]; then
    echo "[xx-stack] pre-commit: drift script not found at $DRIFT_SCRIPT — skipping." >&2
    exit 0
fi

echo "[xx-stack] Checking canonical vs OpenCode source drift..."

if ! node "$DRIFT_SCRIPT"; then
    echo ""
    echo "ERROR: xx-stack/runtime and opencode-orchestration/opencode have drifted."
    echo "Canonical wins: resync the OpenCode copy, or add a KNOWN_DELTAS entry with a reason."
    exit 1
fi

echo "[xx-stack] Runtime and OpenCode sources are aligned."

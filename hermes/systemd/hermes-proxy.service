[Unit]
Description=Hermes orchestrator loopback proxy (OpenAI-compatible)
After=network-online.target
Wants=network-online.target

[Service]
# Paths assume the repo is cloned at /media/Working-Storage/GitHub/XX-Stack — adjust if it lives elsewhere.
Type=simple
WorkingDirectory=/media/Working-Storage/GitHub/XX-Stack/hermes
# Provide HERMES_PROXY_TOKEN via an environment file kept out of the repo.
EnvironmentFile=%h/.config/hermes-orchestration/proxy.env
ExecStart=/usr/bin/python3 /media/Working-Storage/GitHub/XX-Stack/hermes/scripts/hermes_orchestrator.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

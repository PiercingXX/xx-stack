{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["shared_instructions.md"],
  "mcp": {
    "xx-stack-platform-routing": {
      "type": "local",
      "enabled": true,
      "command": ["node", "../mcp-server/dist/index.js"]
    }
  },
  "provider": {
    "llama-cpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TurboQuant-llama.cpp-Local",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    },
    "sglang-remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SGLang-Example-GPU-Box",
      "options": {
        "baseURL": "http://example-gpu-box:30000/v1"
      }
    },
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama-Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama-Example-GPU-Box",
      "options": {
        "baseURL": "http://example-gpu-box:11434/v1"
      }
    }
  },
  "agent": {
    "build": {
      "description": "Primary execution agent. Implements features fast on local GPUs, then runs quality gates before handoff.",
      "mode": "primary",
      "color": "#3b82f6",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.2,
      "steps": 18,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "*"
        ],
        "deny": [
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "project"
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "allow",
          "ping": "deny",
          "parallel-execution-orchestrator": "deny"
        }
      }
    },
    "plan": {
      "description": "Primary planning agent. Deep analysis and architecture trade-offs on the strongest available local reasoning tier first, with remote/cloud escalation only when explicitly justified.",
      "mode": "primary",
      "color": "#8b5cf6",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 14,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "route_*",
          "list_*",
          "check_health",
          "search_tools",
          "agent_*",
          "task_*",
          "supervisor_status"
        ],
        "deny": [
          "task_suspend",
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "project"
      },
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "deny",
          "research": "allow",
          "architect": "allow",
          "deep-thinker": "allow",
          "reasoning-fast": "allow",
          "reviewer": "allow"
        }
      }
    },
    "fast-build": {
      "description": "Primary fast lane for small, obvious implementation tasks on local inventory. Use when routing is obvious and speed matters more than orchestration depth.",
      "mode": "primary",
      "color": "#22c55e",
      "model": "llama-cpp-local/qwen3-coder:30b-a3b-tq2_0",
      "temperature": 0.25,
      "steps": 12,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "deny",
          "reviewer": "allow",
          "qa-lead": "allow"
        }
      }
    },
    "architect": {
      "description": "System architecture specialist. Produces failure-aware designs and implementation plans using the strongest reasoning tier available in the platform registry, including enabled cloud providers when self-hosted options are insufficient.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.15,
      "steps": 16,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Code review specialist. Focuses on production bugs, security gaps, and missing tests.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 12,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "qa-lead": {
      "description": "QA verification specialist. Validates critical user journeys and regression risk before ship.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.15,
      "steps": 12,
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "completion-judge": {
      "description": "Independent completion gatekeeper. Validates contract criteria and evidence before allowing completion.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0,
      "steps": 14,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "supervisor_record_completion_check",
          "supervisor_status",
          "agent_memory_get",

          "search_tools",
          "list_*",
          "route_*",
          "task_*"
        ],
        "deny": [
          "supervisor_complete_session",
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "project"
      },
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "research": {
      "description": "Read-heavy exploration specialist. Maps codebase, risks, and dependency impact while preferring lower-cost self-hosted reasoning lanes before escalating to enabled cloud providers.",
      "mode": "all",
      "color": "#06b6d4",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 12,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "route_*",
          "list_*",
          "check_health",
          "search_tools",
          "agent_memory_*",
          "task_*"
        ],
        "deny": [
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "local"
      },
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "release-manager": {
      "description": "Release orchestration specialist. Runs deploy checks, CI gates, and post-deploy verification.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 16,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "incident-commander": {
      "description": "Incident response specialist. Drives triage, rollback, and postmortem workflows.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 14,
      "permission": {
        "edit": "ask",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "execution-orchestrator": {
      "description": "Deterministic plan-exec wrapper. Handles bounded review/update workflows directly and executes complex orchestration in the same lane with bounded reliability checks.",
      "mode": "primary",
      "color": "#f59e0b",
      "model": "llama-cpp-local/qwen3.5:27b-tq2_0",
      "temperature": 0.05,
      "steps": 28,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "*"
        ],
        "deny": [
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "project"
      },
      "coordinator": {
        "strictWorkerContract": true,
        "requireStructuredResults": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "allow",
          "ping": "deny"
        }
      }
    },
    "parallel-execution-orchestrator": {
      "description": "Parallelized deterministic wrapper. Keeps orchestration on the pinned local llama.cpp lane while distributing delegated subagent slices across healthy remote hosts with watchdog failover.",
      "mode": "primary",
      "color": "#ef4444",
      "model": "llama-cpp-local/qwen3-coder:30b-a3b-tq2_0",
      "temperature": 0.0,
      "steps": 20,
      "requiredMcpServers": [
        "xx-stack-platform-routing"
      ],
      "toolPolicy": {
        "allow": [
          "*"
        ],
        "deny": [
          "task_create",
          "supervisor_start_session",
          "supervisor_tick",
          "supervisor_complete_session",
          "supervisor_abort_session"
        ]
      },
      "memory": {
        "enabled": true,
        "scope": "project"
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        },
        "task": {
          "*": "allow",
          "ping": "deny"
        }
      }
    },
    "performance-engineer": {
      "description": "Performance and regression specialist using a fast remote coding model lane.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 14,
      "permission": {
        "edit": "ask",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "reasoning-fast": {
      "description": "Lower-latency reasoning lane for medium-complexity planning tasks, typically routed to a smaller remote model first and then to an enabled cloud fast-reasoning model when needed.",
      "mode": "subagent",
      "model": "llama-cpp-local/ministral-3:14b-tq2_0",
      "temperature": 0.1,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "rust-rewrite": {
      "description": "Autonomous one-shot rewrite lane for full app migrations to Rust with compile/test auto-repair loops.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 40,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "model-trainer": {
      "description": "Autonomous model training and knowledge injection lane with strategy auto-selection and hard evaluation gates.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.1,
      "steps": 32,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "deep-thinker": {
      "description": "Deep reasoning specialist on the strongest reasoning tier available from the live registry. Produces decision-grade architecture, risk, and optimization plans.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.15,
      "steps": 16,
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "skill": {
          "*": "allow"
        }
      }
    },
    "design-engineer": {
      "description": "AI-driven design artifact specialist. Builds web prototypes, mobile screens, decks, dashboards, and office docs using 31 open-design workflow skills, 149 brand design systems, and 57 aesthetic styles. Sources: nexu-io/open-design, VoltAgent/awesome-design-md, bergside/awesome-design-skills.",
      "mode": "subagent",
      "model": "sglang-remote/qwen3-coder-next",
      "temperature": 0.25,
      "steps": 20,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "ping": {
      "description": "Minimal OpenCode runner health probe. Returns the requested text exactly and performs no other work.",
      "mode": "subagent",
      "hidden": true,
      "model": "llama-cpp-local/qwen3-coder:30b-a3b-tq2_0",
      "temperature": 0,
      "steps": 2,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "skill": "deny"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "webfetch": "ask"
  }
}

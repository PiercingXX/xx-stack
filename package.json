{
  "name": "xx-stack",
  "version": "1.63.0",
  "description": "Local-first agent orchestration: routing MCP server, agent contracts, and self-hosted inference control plane",
  "private": true,
  "//type": "Intentionally NOT \"module\". Shared helpers under xx-stack/scripts/*.js are CommonJS; ESM entrypoints use the .mjs extension. xx-stack/mcp-server declares its own \"type\": \"module\".",
  "workspaces": [
    "xx-stack/mcp-server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "npm --prefix xx-stack/mcp-server run build -- --noEmit",
    "format": "prettier --write \"{xx-stack/mcp-server/src,xx-stack/scripts}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"{xx-stack/mcp-server/src,xx-stack/scripts}/**/*.{ts,js,mjs}\"",
    "layout:verify": "npm run layout:verify:core && npm run layout:verify:opencode",
    "layout:verify:core": "node xx-stack/scripts/verify-repo-layout.mjs xx-stack",
    "layout:verify:opencode": "node xx-stack/scripts/verify-repo-layout.mjs opencode-orchestration",
    "agents:sync": "node xx-stack/scripts/sync-vscode-agents.mjs",
    "agents:check": "node xx-stack/scripts/sync-vscode-agents.mjs --check",
    "design:catalog": "node xx-stack/scripts/generate-design-catalog.mjs",
    "design:golden": "node xx-stack/scripts/evaluate-golden-tasks.mjs",
    "design:html-gate": "node xx-stack/scripts/quality-gate-html.mjs",
    "hermes:test": "cd hermes-orchestration && python3 -m unittest discover -s tests",
    "verify": "npm run layout:verify && npm run agents:check && npm run drift:check && npm run rules:check && npm run nano:check && npm run inventory:check && npm run guardrails:check && npm test && npm run hermes:test",
    "drift:check": "node xx-stack/scripts/check-stack-source-drift.mjs",
    "rules:check": "node xx-stack/scripts/check-rules-coverage.mjs",
    "nano:check": "node xx-stack/scripts/check-nano-tiers.mjs",
    "guardrails:check": "node xx-stack/scripts/check-dangerous-patterns.mjs",
    "inventory:sync": "node xx-stack/scripts/generate-registries.mjs",
    "inventory:check": "node xx-stack/scripts/generate-registries.mjs --check",
    "inventory:scan": "node xx-stack/scripts/scan-tailscale.mjs",
    "inventory:list": "node xx-stack/scripts/toggle-lane.mjs list",
    "inventory:enable": "node xx-stack/scripts/toggle-lane.mjs enable",
    "inventory:disable": "node xx-stack/scripts/toggle-lane.mjs disable"
  },
  "keywords": [
    "mcp",
    "agents",
    "autonomous",
    "routing",
    "self-hosted",
    "opencode"
  ],
  "author": "xx-stack contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^6.0.2"
  }
}

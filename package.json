{
  "name": "xx-stack",
  "version": "1.66.0",
  "description": "Local-first agent orchestration: routing MCP server, agent contracts, and self-hosted inference control plane",
  "private": true,
  "//type": "Intentionally NOT \"module\". Shared helpers under scripts/*.js are CommonJS; ESM entrypoints use the .mjs extension. mcp-server declares its own \"type\": \"module\".",
  "workspaces": [
    "mcp-server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm --prefix mcp-server run build -- --noEmit",
    "format": "prettier --write \"{mcp-server/src,scripts}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"{mcp-server/src,scripts}/**/*.{ts,js,mjs}\"",
    "layout:verify": "npm run layout:verify:core && npm run layout:verify:opencode",
    "layout:verify:core": "node scripts/verify-repo-layout.mjs .",
    "layout:verify:opencode": "node scripts/verify-repo-layout.mjs opencode-orchestration",
    "design:catalog": "node scripts/generate-design-catalog.mjs",
    "design:golden": "node scripts/evaluate-golden-tasks.mjs",
    "design:html-gate": "node scripts/quality-gate-html.mjs",
    "design:systems-lint": "node packs/design/scripts/lint-design-systems.mjs",
    "hermes:test": "cd hermes-orchestration && python3 -m unittest discover -s tests",
    "verify": "npm run layout:verify && npm run drift:check && npm run rules:check && npm run nano:check && npm run inventory:check && npm run guardrails:check && npm run ci:parity && npm run lint && npm run format:check && npm run design:golden && npm run design:html-gate && npm run design:systems-lint && npm run design:craft-refs && npm run design:anti-slop-test && npm test && npm run hermes:test",
    "drift:check": "node scripts/check-stack-source-drift.mjs",
    "rules:check": "node scripts/check-rules-coverage.mjs",
    "nano:check": "node scripts/check-nano-tiers.mjs",
    "guardrails:check": "node scripts/check-dangerous-patterns.mjs",
    "ci:parity": "node scripts/check-ci-parity.mjs",
    "inventory:sync": "node scripts/generate-registries.mjs",
    "inventory:check": "node scripts/generate-registries.mjs --check",
    "inventory:scan": "node scripts/scan-tailscale.mjs",
    "inventory:list": "node scripts/toggle-lane.mjs list",
    "inventory:enable": "node scripts/toggle-lane.mjs enable",
    "inventory:disable": "node scripts/toggle-lane.mjs disable",
    "design:craft-refs": "node packs/design/scripts/check-craft-references.mjs",
    "design:anti-slop-test": "node packs/design/scripts/test-anti-slop-rules.mjs"
  },
  "keywords": [
    "mcp",
    "agents",
    "autonomous",
    "routing",
    "self-hosted",
    "opencode"
  ],
  "author": "xx-stack contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  }
}
